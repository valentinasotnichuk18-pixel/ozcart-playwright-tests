{
  "name": "ozcart-playwright-tests",
  "version": "1.0.0",
  "description": "UI and API test automation for the Ozcart demo store and Swagger Petstore (Playwright, JavaScript)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --project=ui --debug",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
